<Project>
  <!--
    Default paths for a standard Steam install. Override them in Directory.Build.local.props
    (copy Directory.Build.local.props.example) instead of editing this file.
  -->
  <PropertyGroup>
    <SeaPowerDir Condition="'$(SeaPowerDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sea Power</SeaPowerDir>
    <AnchorChainDir Condition="'$(AnchorChainDir)' == ''">$(SeaPowerDir)\..\..\workshop\content\1286220\3380210757</AnchorChainDir>
    <ManagedDir>$(SeaPowerDir)\Sea Power_Data\Managed</ManagedDir>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
</Project>
