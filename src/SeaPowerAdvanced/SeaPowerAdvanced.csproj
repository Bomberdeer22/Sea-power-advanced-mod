<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SeaPowerAdvanced</AssemblyName>
    <RootNamespace>SeaPowerAdvanced</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <Version>0.5.1</Version>
    <AssemblyVersion>0.5.1.0</AssemblyVersion>
    <FindDependenciesOfExternallyResolvedReferences>false</FindDependenciesOfExternallyResolvedReferences>
    <!-- Keep warnings visible but non-fatal: a first build on a new game version should not stop. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AnchorChain" HintPath="$(AnchorChainDir)\AnchorChain.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="BepInEx" HintPath="$(SeaPowerDir)\BepInEx\core\BepInEx.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="0Harmony" HintPath="$(SeaPowerDir)\BepInEx\core\0Harmony.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="Seapower-Scripts" HintPath="$(ManagedDir)\Seapower-Scripts.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UniRx" HintPath="$(ManagedDir)\UniRx.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" ExternallyResolved="true" />
    <!-- BaseUnityPlugin derives from MonoBehaviour, which lives in the legacy monolithic UnityEngine
         assembly, not in CoreModule. Without this the BepInEx entry point fails with CS0012. -->
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" ExternallyResolved="true" />

  </ItemGroup>

  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)\Seapower-Scripts.dll')"
           Text="Sea Power not found. Set SeaPowerDir in Directory.Build.local.props (see Directory.Build.local.props.example)." />
    <Error Condition="!Exists('$(SeaPowerDir)\BepInEx\core\0Harmony.dll')"
           Text="BepInEx not found under $(SeaPowerDir). Install BepInEx/Anchor Chain first." />
    <Error Condition="!Exists('$(AnchorChainDir)\AnchorChain.dll')"
           Text="AnchorChain.dll not found. Set AnchorChainDir in Directory.Build.local.props." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.dll')"
           Text="UnityEngine.dll not found in $(ManagedDir). The game install looks incomplete." />
  </Target>

</Project>
